clean:
		docker volume prune
		@printf "$(BOLD)$(BLUE)[?]:\t $(RESET)Clean completed\n\n"

fclean:	clean
		@printf "$(BOLD)$(CYAN)[?]: $(RESET)Full clean completed!\n\n"

.PHONY: clean fclean
